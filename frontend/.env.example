# ==========================================
# Passu Frontend - Environment Configuration
# ==========================================

# API Base URL for all REST requests and SSE (EventSource) streams
# In local development with Vite proxy, can be left blank or set to /api
# In production, set to your deployed backend API URL (e.g., https://api.passu.com/api or https://passu-backend.onrender.com/api)
VITE_API_URL=http://localhost:8080/api
